# =============================================================
# RiftMind - règles communes au monorepo
# (les règles spécifiques sont dans backend/.gitignore et frontend/.gitignore)
# =============================================================

# --- Systèmes d'exploitation ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- IDE / éditeurs ---
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.sw?
*~

# --- Variables d'environnement / secrets ---
.env
.env.local
.env.*.local
!.env.example

# --- Logs ---
*.log
logs/
