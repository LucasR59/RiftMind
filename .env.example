# Copier en .env (non versionné) pour surcharger les valeurs par défaut de compose.yaml
#   cp .env.example .env

# --- API Riot Games ---
# Clé à récupérer sur https://developer.riotgames.com (la clé de dev expire toutes les 24 h).
# Utilisée UNIQUEMENT par le backend : ne jamais la commiter ni la préfixer par VITE_
# (les variables VITE_* sont incluses dans le JavaScript envoyé au navigateur).
RIOT_API_KEY=

# --- Base de données ---
POSTGRES_DB=riftmind
POSTGRES_USER=riftmind
POSTGRES_PASSWORD=riftmind
POSTGRES_PORT=5432

# --- Ports exposés ---
BACKEND_PORT=8080
BACKEND_DEBUG_PORT=5005
FRONTEND_PORT=5173
ADMINER_PORT=8081
